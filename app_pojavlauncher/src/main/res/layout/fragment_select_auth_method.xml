<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background_app">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <Button android:id="@+id/button_coint_authentication" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/coint_account" android:textAllCaps="false"
            android:backgroundTint="#00D4AD" android:textColor="#041B17" />
        <Button android:id="@+id/button_microsoft_authentication" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:text="@string/coint_microsoft_account" android:textAllCaps="false" />
        <Button android:id="@+id/button_local_authentication" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:text="@string/coint_local_account" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
